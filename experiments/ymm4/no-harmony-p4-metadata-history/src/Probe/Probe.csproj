    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Ymm4P4MetadataHistoryProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="YukkuriMovieMaker.Plugin" />
