<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Ymm4NoHarmonyFolderHandsOn</AssemblyName>
    <Version>0.0.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>YMM4 no-Harmony Layer Folder</Product>
    <Description>YMM4 timeline layer-folder hands-on candidate without Harmony.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="YukkuriMovieMaker.Plugin" />
    <Using Include="YukkuriMovieMaker.Settings" />
    <Reference Include="YukkuriMovieMaker.Plugin"><HintPath>$(YMM4DirPath)YukkuriMovieMaker.Plugin.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="YukkuriMovieMaker"><HintPath>$(YMM4DirPath)YukkuriMovieMaker.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ReactiveProperty.Core"><HintPath>$(YMM4DirPath)ReactiveProperty.Core.dll</HintPath><Private>false</Private></Reference>

    <Compile Include="../../../no-harmony-track-a/src/Probe/Host.cs" Link="Host.cs" />
    <Compile Include="../../../no-harmony-folder-layout-generalization/src/Probe/FolderLayout.cs" Link="FolderLayout.cs" />
    <Compile Include="../../../no-harmony-track-c/src/Probe/GestureDisplay.cs" Link="GestureDisplay.cs" />
    <Compile Include="../../../no-harmony-track-c/src/Probe/InputMapAdapter.cs" Link="InputMapAdapter.cs" />
    <Compile Include="../../../no-harmony-track-c/src/Probe/FileDropAdapter.cs" Link="FileDropAdapter.cs" />
    <Compile Include="../../../no-harmony-p3-persistence/src/FolderDocument.cs" Link="FolderDocument.cs" />
    <Compile Include="../../../no-harmony-p3-persistence/src/FolderDocumentCodec.cs" Link="FolderDocumentCodec.cs" />
    <Compile Include="../../../no-harmony-folder-range-tracker/src/FolderRangeTracker.cs" Link="FolderRangeTracker.cs" />
    <Compile Include="../../../no-harmony-p4-ux-policy/src/FolderUxCommands.cs" Link="FolderUxCommands.cs" />
    <Compile Include="../../../no-harmony-s2-extended-state/src/FolderProductState.cs" Link="FolderProductState.cs" />
    <Compile Include="../../../no-harmony-s2-extended-state/src/FolderProductStateCodec.cs" Link="FolderProductStateCodec.cs" />
    <Compile Include="../../../no-harmony-s3-structural-convenience/src/StructuralConvenienceRules.cs" Link="StructuralConvenienceRules.cs" />
    <Compile Include="../../../no-harmony-s4-panel/src/PanelProjection.cs" Link="PanelProjection.cs" />
    <Compile Include="../../../no-harmony-s4-panel/src/PanelMoveRules.cs" Link="PanelMoveRules.cs" />
    <Compile Include="../../../no-harmony-s5-visual-summary/src/VisualSummaryRules.cs" Link="VisualSummaryRules.cs" />
    <Compile Include="../../../no-harmony-p6-hardening/src/*.cs" Link="P6Hardening/%(Filename)%(Extension)" Condition="'$(EnableP6Hardening)' == 'true'" />
  </ItemGroup>

  <Target Name="MakeYmme" AfterTargets="Build" Condition="'$(PackYmme)' == 'true'">
    <PropertyGroup>
      <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\..\..'))</RepoRoot>
      <CandidateRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</CandidateRoot>
      <YmmeStageRoot>$(OutputPath)ymme</YmmeStageRoot>
      <YmmeStage>$(YmmeStageRoot)\$(AssemblyName)</YmmeStage>
      <YmmeOut>$(RepoRoot)\publish\$(AssemblyName).P4.4.ymme</YmmeOut>
    </PropertyGroup>

    <RemoveDir Directories="$(YmmeStageRoot)" />
    <MakeDir Directories="$(YmmeStage)" />

    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(YmmeStage)" />
    <Copy SourceFiles="$(CandidateRoot)\README.md"
          DestinationFiles="$(YmmeStage)\README.md" />
    <Copy SourceFiles="$(RepoRoot)\docs\YMM4_NO_HARMONY_P4_HANDS_ON.md"
          DestinationFiles="$(YmmeStage)\HANDS_ON.md" />

    <MakeDir Directories="$(RepoRoot)\publish" />
    <Delete Files="$(YmmeOut)" />
    <ZipDirectory SourceDirectory="$(YmmeStageRoot)"
                  DestinationFile="$(YmmeOut)"
                  Overwrite="true" />
    <Message Text="ymme package created: $(YmmeOut)" Importance="high" />
  </Target>
</Project>
